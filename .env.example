# ==============================================================================
# COMPANIO PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string with PgBouncer for Vercel serverless functions
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct connection string for Prisma migrations & schema pushes
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Minimum 32-character random string for signing JWT tokens and session cookies
JWT_SECRET="generate-a-secure-random-32-char-jwt-secret-key-here"
NEXTAUTH_SECRET="generate-a-secure-random-32-char-nextauth-secret-here"

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY (Pass Paywalls & Escrow)
# ------------------------------------------------------------------------------
# Leave as 'rzp_test_placeholder' for instant zero-friction sandbox simulation.
# Or provide your live/test credentials from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"

# ------------------------------------------------------------------------------
# 4. CASHFREE PAYMENTS (Instant Host UPI Payouts)
# ------------------------------------------------------------------------------
CASHFREE_APP_ID="cf_app_placeholder"
CASHFREE_SECRET_KEY="cf_secret_placeholder"
CASHFREE_ENV="TEST"

# ------------------------------------------------------------------------------
# 5. REAL-TIME WEBSOCKET (Optional External Service)
# ------------------------------------------------------------------------------
# If deploying standalone server/ws-server.ts on Railway or Render, set WSS URL.
# If left empty, chat seamlessly uses automated 2.5s REST polling on Vercel.
NEXT_PUBLIC_WS_URL=""

# ------------------------------------------------------------------------------
# 6. APPLICATION URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 7. FIREBASE PHONE AUTH (10,000 Free Production SMS / Month)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
