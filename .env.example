# Database Connection (PostgreSQL)
# For local or hosted databases (Supabase, Neon, Railway)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/companio_db?schema=public"

# Authentication & Security
JWT_SECRET="companio-production-secure-jwt-secret-key-32chars"
NEXTAUTH_SECRET="companio-nextauth-session-encryption-key"

# URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Payment Gateways (Sandbox Mode)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
CASHFREE_APP_ID="cf_app_placeholder"
CASHFREE_SECRET_KEY="cf_secret_placeholder"
CASHFREE_ENV="TEST"
